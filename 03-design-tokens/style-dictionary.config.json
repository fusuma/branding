{
  "$schema": "https://raw.githubusercontent.com/amzn/style-dictionary/main/types/config.d.ts",
  "source": [
    "03-design-tokens/global/**/*.tokens.json",
    "03-design-tokens/semantic/**/*.tokens.json"
  ],
  "platforms": {
    "css": {
      "transformGroup": "css",
      "buildPath": "dist/tokens/css/",
      "prefix": "ff",
      "files": [
        {
          "destination": "variables.css",
          "format": "css/variables",
          "options": {
            "outputReferences": true,
            "selector": ":root"
          }
        }
      ]
    },
    "css-light": {
      "transformGroup": "css",
      "buildPath": "dist/tokens/css/",
      "prefix": "ff",
      "source": [
        "03-design-tokens/themes/light.tokens.json"
      ],
      "files": [
        {
          "destination": "theme-light.css",
          "format": "css/variables",
          "options": {
            "outputReferences": true,
            "selector": ":root, [data-theme=\"light\"]"
          }
        }
      ]
    },
    "css-dark": {
      "transformGroup": "css",
      "buildPath": "dist/tokens/css/",
      "prefix": "ff",
      "source": [
        "03-design-tokens/themes/dark.tokens.json"
      ],
      "files": [
        {
          "destination": "theme-dark.css",
          "format": "css/variables",
          "options": {
            "outputReferences": true,
            "selector": "[data-theme=\"dark\"]"
          }
        }
      ]
    },
    "scss": {
      "transformGroup": "scss",
      "buildPath": "dist/tokens/scss/",
      "prefix": "ff",
      "files": [
        {
          "destination": "_variables.scss",
          "format": "scss/variables",
          "options": {
            "outputReferences": true
          }
        },
        {
          "destination": "_map.scss",
          "format": "scss/map-deep",
          "options": {
            "outputReferences": true
          }
        }
      ]
    },
    "js": {
      "transformGroup": "js",
      "buildPath": "dist/tokens/js/",
      "files": [
        {
          "destination": "tokens.js",
          "format": "javascript/es6"
        },
        {
          "destination": "tokens.cjs",
          "format": "javascript/module-flat"
        }
      ]
    },
    "json": {
      "transformGroup": "js",
      "buildPath": "dist/tokens/json/",
      "files": [
        {
          "destination": "tokens.json",
          "format": "json/flat"
        },
        {
          "destination": "tokens-nested.json",
          "format": "json/nested"
        }
      ]
    },
    "ts": {
      "transformGroup": "js",
      "buildPath": "dist/tokens/ts/",
      "files": [
        {
          "destination": "tokens.ts",
          "format": "javascript/es6",
          "options": {
            "outputStringLiterals": true
          }
        },
        {
          "destination": "tokens.d.ts",
          "format": "typescript/es6-declarations"
        }
      ]
    },
    "ios-swift": {
      "transformGroup": "ios-swift",
      "buildPath": "dist/tokens/ios/",
      "files": [
        {
          "destination": "DesignTokens.swift",
          "format": "ios-swift/enum.swift",
          "className": "FlavioFusumaTokens",
          "options": {
            "accessControl": "public"
          }
        },
        {
          "destination": "Color+Tokens.swift",
          "format": "ios-swift/class.swift",
          "className": "FlavioFusumaColors",
          "filter": {
            "type": "color"
          },
          "options": {
            "accessControl": "public"
          }
        }
      ]
    },
    "android": {
      "transformGroup": "android",
      "buildPath": "dist/tokens/android/",
      "files": [
        {
          "destination": "colors.xml",
          "format": "android/colors",
          "resourceType": "color",
          "filter": {
            "type": "color"
          }
        },
        {
          "destination": "dimens.xml",
          "format": "android/dimens",
          "resourceType": "dimen",
          "filter": {
            "type": "dimension"
          }
        },
        {
          "destination": "font_dimens.xml",
          "format": "android/fontDimens",
          "resourceType": "dimen",
          "filter": {
            "type": "dimension"
          }
        }
      ]
    }
  }
}
