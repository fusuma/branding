{
  "$description": "Flavio Fusuma dark theme -- maps semantic tokens to global primitives for dark mode",
  "color": {
    "background": {
      "primary": { "$value": "{color.neutral.900}", "$type": "color", "$description": "Default page background" },
      "secondary": { "$value": "{color.neutral.800}", "$type": "color", "$description": "Subtle section background" },
      "tertiary": { "$value": "{color.neutral.700}", "$type": "color", "$description": "Inset or recessed background" },
      "inverse": { "$value": "{color.neutral.50}", "$type": "color", "$description": "Inverted background for contrast" },
      "brand": { "$value": "{color.blue.800}", "$type": "color", "$description": "Brand-colored background" },
      "brand-subtle": { "$value": "#1E3A5F26", "$type": "color", "$description": "Subtle brand tint (15% opacity on dark)" },
      "brand-muted": { "$value": "#1E3A5F40", "$type": "color", "$description": "Muted brand tint (25% opacity on dark)" },
      "accent": { "$value": "{color.amber.500}", "$type": "color", "$description": "Accent-colored background" },
      "accent-subtle": { "$value": "#F59E0B1A", "$type": "color", "$description": "Subtle accent tint (10% opacity on dark)" },
      "accent-muted": { "$value": "#F59E0B33", "$type": "color", "$description": "Muted accent tint (20% opacity on dark)" },
      "success": { "$value": "#22C55E1A", "$type": "color", "$description": "Success background (10% on dark)" },
      "warning": { "$value": "#F59E0B1A", "$type": "color", "$description": "Warning background (10% on dark)" },
      "error": { "$value": "#EF44441A", "$type": "color", "$description": "Error background (10% on dark)" },
      "info": { "$value": "#3B82F61A", "$type": "color", "$description": "Info background (10% on dark)" },
      "disabled": { "$value": "{color.neutral.800}", "$type": "color" },
      "overlay": { "$value": "#000000B3", "$type": "color", "$description": "Modal overlay at 70% opacity" },
      "elevated": { "$value": "{color.neutral.800}", "$type": "color", "$description": "Elevated surface (cards, dialogs)" },
      "sunken": { "$value": "{color.neutral.950}", "$type": "color", "$description": "Sunken / inset area" }
    },
    "text": {
      "primary": { "$value": "{color.neutral.50}", "$type": "color", "$description": "Primary body text" },
      "secondary": { "$value": "{color.neutral.400}", "$type": "color", "$description": "Secondary/supporting text" },
      "tertiary": { "$value": "{color.neutral.500}", "$type": "color", "$description": "Placeholder and hint text" },
      "inverse": { "$value": "{color.neutral.900}", "$type": "color", "$description": "Text on light backgrounds" },
      "brand": { "$value": "{color.blue.300}", "$type": "color", "$description": "Brand-colored text (lightened for dark bg)" },
      "accent": { "$value": "{color.amber.400}", "$type": "color", "$description": "Accent-colored text" },
      "link": { "$value": "{color.blue.400}", "$type": "color", "$description": "Hyperlink text" },
      "link-hover": { "$value": "{color.blue.300}", "$type": "color", "$description": "Hovered hyperlink text" },
      "link-visited": { "$value": "{color.violet.400}", "$type": "color", "$description": "Visited hyperlink text" },
      "success": { "$value": "{color.green.400}", "$type": "color" },
      "warning": { "$value": "{color.amber.400}", "$type": "color" },
      "error": { "$value": "{color.red.400}", "$type": "color" },
      "info": { "$value": "{color.blue.400}", "$type": "color" },
      "disabled": { "$value": "{color.neutral.600}", "$type": "color" },
      "on-brand": { "$value": "{color.neutral.0}", "$type": "color", "$description": "Text on brand background" },
      "on-accent": { "$value": "{color.neutral.950}", "$type": "color", "$description": "Text on accent background" }
    },
    "border": {
      "primary": { "$value": "{color.neutral.700}", "$type": "color", "$description": "Default border" },
      "secondary": { "$value": "{color.neutral.600}", "$type": "color", "$description": "Emphasized border" },
      "tertiary": { "$value": "{color.neutral.800}", "$type": "color", "$description": "Subtle divider" },
      "brand": { "$value": "{color.blue.400}", "$type": "color" },
      "accent": { "$value": "{color.amber.500}", "$type": "color" },
      "focus": { "$value": "{color.blue.400}", "$type": "color", "$description": "Focus ring color" },
      "success": { "$value": "{color.green.400}", "$type": "color" },
      "warning": { "$value": "{color.amber.400}", "$type": "color" },
      "error": { "$value": "{color.red.400}", "$type": "color" },
      "info": { "$value": "{color.blue.400}", "$type": "color" },
      "disabled": { "$value": "{color.neutral.700}", "$type": "color" },
      "inverse": { "$value": "{color.neutral.300}", "$type": "color" }
    },
    "icon": {
      "primary": { "$value": "{color.neutral.300}", "$type": "color" },
      "secondary": { "$value": "{color.neutral.500}", "$type": "color" },
      "brand": { "$value": "{color.blue.400}", "$type": "color" },
      "accent": { "$value": "{color.amber.400}", "$type": "color" },
      "inverse": { "$value": "{color.neutral.900}", "$type": "color" },
      "success": { "$value": "{color.green.400}", "$type": "color" },
      "warning": { "$value": "{color.amber.400}", "$type": "color" },
      "error": { "$value": "{color.red.400}", "$type": "color" },
      "info": { "$value": "{color.blue.400}", "$type": "color" },
      "disabled": { "$value": "{color.neutral.600}", "$type": "color" }
    },
    "interactive": {
      "primary": { "$value": "{color.blue.500}", "$type": "color" },
      "primary-hover": { "$value": "{color.blue.400}", "$type": "color" },
      "primary-active": { "$value": "{color.blue.300}", "$type": "color" },
      "secondary": { "$value": "{color.neutral.800}", "$type": "color" },
      "secondary-hover": { "$value": "{color.neutral.700}", "$type": "color" },
      "secondary-active": { "$value": "{color.neutral.600}", "$type": "color" },
      "accent": { "$value": "{color.amber.500}", "$type": "color" },
      "accent-hover": { "$value": "{color.amber.400}", "$type": "color" },
      "accent-active": { "$value": "{color.amber.300}", "$type": "color" },
      "destructive": { "$value": "{color.red.500}", "$type": "color" },
      "destructive-hover": { "$value": "{color.red.400}", "$type": "color" },
      "destructive-active": { "$value": "{color.red.300}", "$type": "color" }
    }
  },
  "shadow": {
    "elevation-1": {
      "$value": [
        { "color": "#00000033", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
        { "color": "#00000026", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" }
      ],
      "$type": "shadow"
    },
    "elevation-2": {
      "$value": [
        { "color": "#00000033", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "-1px" },
        { "color": "#00000026", "offsetX": "0px", "offsetY": "4px", "blur": "6px", "spread": "-1px" }
      ],
      "$type": "shadow"
    },
    "elevation-3": {
      "$value": [
        { "color": "#00000040", "offsetX": "0px", "offsetY": "4px", "blur": "6px", "spread": "-2px" },
        { "color": "#00000033", "offsetX": "0px", "offsetY": "10px", "blur": "15px", "spread": "-3px" }
      ],
      "$type": "shadow"
    },
    "elevation-4": {
      "$value": [
        { "color": "#00000040", "offsetX": "0px", "offsetY": "10px", "blur": "15px", "spread": "-3px" },
        { "color": "#00000033", "offsetX": "0px", "offsetY": "20px", "blur": "25px", "spread": "-5px" }
      ],
      "$type": "shadow"
    },
    "elevation-5": {
      "$value": [
        { "color": "#0000004D", "offsetX": "0px", "offsetY": "20px", "blur": "25px", "spread": "-5px" },
        { "color": "#00000040", "offsetX": "0px", "offsetY": "40px", "blur": "50px", "spread": "-12px" }
      ],
      "$type": "shadow"
    }
  }
}
